-- Typing-only mirror of `local_conversations` (docs/schema/go-sdk-schema.sql).
-- Runtime schema creation uses the verbatim Go SDK DDL in GoSdkSchema.kt.
CREATE TABLE local_conversations (
    conversation_id TEXT NOT NULL PRIMARY KEY,
    conversation_type INTEGER,
    user_id TEXT,
    group_id TEXT,
    show_name TEXT,
    face_url TEXT,
    recv_msg_opt INTEGER,
    unread_count INTEGER,
    group_at_type INTEGER,
    latest_msg TEXT,
    latest_msg_send_time INTEGER,
    draft_text TEXT,
    draft_text_time INTEGER,
    is_pinned INTEGER AS kotlin.Boolean,
    is_private_chat INTEGER AS kotlin.Boolean,
    burn_duration INTEGER DEFAULT 30,
    is_not_in_group INTEGER AS kotlin.Boolean,
    update_unread_count_time INTEGER,
    attached_info TEXT,
    ex TEXT,
    max_seq INTEGER,
    min_seq INTEGER,
    msg_destruct_time INTEGER DEFAULT 604800,
    is_msg_destruct INTEGER AS kotlin.Boolean DEFAULT 0
);

CREATE INDEX index_latest_msg_send_time ON local_conversations(latest_msg_send_time);

getAll:
SELECT * FROM local_conversations ORDER BY
    CASE WHEN is_pinned = 1 THEN 0 ELSE 1 END,
    CASE WHEN draft_text_time > latest_msg_send_time THEN draft_text_time ELSE latest_msg_send_time END DESC;

getByID:
SELECT * FROM local_conversations WHERE conversation_id = ?;

totalUnreadCount:
SELECT COALESCE(SUM(unread_count), 0) FROM local_conversations WHERE recv_msg_opt < 2;

upsert:
INSERT OR REPLACE INTO local_conversations VALUES ?;

deleteByID:
DELETE FROM local_conversations WHERE conversation_id = ?;
